{
  "name": "sunshine",
  "version": "0.0.0",
  "scripts": {
    "build": "vite build --mode prod",
    "build:debug": "vite build --mode debug",
    "dev": "vite build --mode debug --watch",
    "serve": "serve ./tests/fixtures/http --no-port-switching",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint --ext .js,.mjs,.ts,.mts,.vue . --max-warnings 0",
    "lint:fix": "eslint --ext .js,.ts,.vue . --fix",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:theme": "node tests/theme-browser.mts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.5.2",
    "axios": "1.20.0",
    "naive-ui": "^2.39.0",
    "pinia": "^2.1.8",
    "vue": "3.5.42",
    "vue-i18n": "11.1.11",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "unplugin-vue-components": "30.0.0",
    "vite": "^6.4.3",
    "vite-plugin-ejs": "1.6.4",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "^3.0.6"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  }
}
